# Copy to ~/.config/omp-discord/bot.env (mode 600). Never commit the real file.
# Discord Developer Portal → your application → Bot → Reset Token.
DISCORD_BOT_TOKEN=
# Discord Developer Portal → your application → General Information → Application ID.
DISCORD_APP_ID=

# Optional overrides (defaults in src/config.ts):
# OMP_BOT_CONFIG=~/.config/omp-discord/config.json   # non-secret settings file
# OMP_BOT_MAX_CONCURRENT=2                            # agent runs at the same time
# OMP_BOT_TIMEOUT_MIN=30                              # one run's time limit
# OMP_BOT_HTTP_PORT=47821                             # loopback /post and /health
# OMP_BOT_SHORTCUT_PORT=47823                         # iPhone Shortcut server (loopback)
# OMP_BOT_OMP_BIN=~/.local/share/mise/shims/omp       # omp binary the bot runs
# OMP_BOT_APPROVAL_WORKSPACE=Github                   # Herdr workspace for approval tabs
# KOKORO_DIR=~/Github/tools/kokoro-tts                # TTS models + venv (scripts/tts_server.py)

# Optional second bot for the Lofi radio (scripts/radio.ts) goes in ~/.config/omp-discord/radio.env:
# RADIO_BOT_TOKEN=
# RADIO_STREAM_URL=        # live stream URL for yt-dlp (default in scripts/radio.ts)
# RADIO_PROXY=             # optional socks5h:// proxy for a second try
