    # R10 idle list (pure idle_scan)
    old, recent = "2026-01-01 00:00", datetime.fromtimestamp(now - 3600).strftime("%Y-%m-%d %H:%M")
    P = lambda **k: {"area": "Tools", "s": "partial", "changed": old, "n": "", **k}
    its = [P(id="i1"), P(id="i2a", by="autoclear", cts=now * 1000), P(id="i2m", by="manual", cts=now * 1000),
           P(id="i3", changed=recent), {"id": "open1", "s": "planned"}, {"id": "done1", "s": "done"},
