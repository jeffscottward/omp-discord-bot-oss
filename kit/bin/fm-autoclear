    ms = lambda t: int(t * 1000)
    its2 = [P(id="h1", changed=recent, hist=[{"by": "pane:x", "cts": ms(now - 3 * 3600)}, {"by": "autoclear", "cts": ms(now - 60)}]),
            P(id="h2", hist=[{"by": "manual", "cts": ms(now - 3600)}, {"by": "autoclear", "cts": ms(now - 60)}]),
            P(id="h3", changed=recent, hist=[{"by": "autoclear", "cts": ms(now - 5 * 3600)}, {"by": "autoclear", "cts": ms(now - 60)}])]
    got2 = {i["id"] for i in idle_scan(its2, ctx)[0]}
    ok(got2 == {"h1", "h3"}, f"only autoclear wrote recently -> still idle: {sorted(got2)}")
    # R11 receipts (Orca #3)
    a = D(id="rc1", s="running", job="W", n="working: 🔧 Work. x")
    ok(a[0][0] == "set" and a[0][1][1] == "done" and a[0][1][2].startswith("🧾 Receipt done (") and "pane wB:p1): built it. Evidence: commit abc." in a[0][1][2], a)
    ok(a[1] == ("field", ["rc1", "receipt", str(ms(now))], "R11 receipt applied") and len(a) == 2, a)
    a = D(id="rc1", s="partial", job="W", receipt=str(ms(now)))
    ok(a == [], f"an applied receipt is not applied twice, and R3 does not reopen the card: {a}")
    a = D(id="rc2", s="running", job="W", n="x")
    ok(a[0][1][1] == "partial" and a[0][1][2].endswith("(job was W) [needs check]") and a[0][2] == "R11 receipt failed", a)
    ok(a[1][0] == "field" and a[1][1][1] == "receipt" and a[2] == ("field", ["rc2", "job", "-"], "R11 job ended"), a)
    a = D(id="rc3", s="running", job="W", src="https://discord.com/channels/1/2/3")
    ok(a[0][1][1] == "partial" and a[0][1][2].endswith("[blocked; not an owner step]") and a[2] == ("field", ["rc3", "job", "-"], "R11 job ended"), f"blocked without a link is not an owner step: {a}")
    a = D(id="rc3l", s="running", job="W")
    ok(a[0] == ("q", ["rc3l", q], "R11 receipt link") and a[1][1][1] == "blocked" and "🧾 Receipt blocked" in a[1][1][2], a)
    a = D(id="rc3s", s="running"); ok(a[0] == ("field", ["rc3s", "src", "https://discord.com/channels/1/2/7"], "R11 receipt link") and a[1][1][1] == "blocked" and len(a) == 3, a)
    a = D(id="rc3b", s="running")
    ok(a[0] == ("field", ["rc3b", "blockedBy", "card-a,card-b"], "R11 receipt blockedBy") and a[1][1][1] == "partial" and a[1][1][2].endswith("[blocked by card-a, card-b]"), a)
    a = D(id="rc3q", s="waiting", queued="1", src="https://discord.com/channels/1/2/3"); ok(a[0][1][1] == "partial" and len(a) == 2, f"R9: queued blocked -> partial {a}")
    a = D(id="rc3ql", s="waiting", queued="1"); ok(a[0][1][1] == "partial" and len(a) == 2, f"queued + link -> partial, no link copy {a}")
    a = D(id="rcT", s="running", area="Finance", job="W"); ok(a and a[0][1][1] == "done" and a[0][2] == "R11 receipt done", f"a receipt also closes a finance card (owner 2026-10-22): {a}")
    ok(not finance({"id": "x", "area": "tools", "t": "finance tables image-only"}), "title words do not make a card a finance card")
    a = D(id="rcT", s="running", area="Finance", job="W", cts=str(ms(now) + 3_600_000)); ok(a == [("field", ["rcT", "receipt", str(ms(now))], "R11 stale receipt skipped (card changed after it)")], f"stale receipt: {a}")
    ok(finance({"id": "x", "area": "Finance", "t": "anything"}), "area finance is a finance card")
    ok(D(id="rcA", s="done") == [], "done cards stay as they are")
    a = D(id="rcW", s="waiting", src="https://discord.com/channels/1/2/3"); ok(a[0][1][1] == "done", f"a done receipt closes a waiting card too: {a}")
    a = D(id="rcX", s="partial", job="W"); ok(a[-1][2] == "R3 job working", f"a receipt for another card is ignored: {a}")
    a = D(id="rcB", s="partial", job="W"); ok(a[-1][2] == "R3 job working", f"unknown result is ignored: {a}")
    a = D(id="rcO", s="partial", job="W", receipt=str(ms(now - 3 * 3600)), hist=[{"by": "run:x", "cts": ms(now - 600)}])
    ok(a[-1][2] == "R3 job working", f"a restarted card (real change after the receipt) may run again: {a}")
    ok(receipt_ms({"ts": "2026-10-19T11:00:00-0400"}) == ms(datetime(2026, 10, 19, 15, 0).replace(tzinfo=__import__("datetime").timezone.utc).timestamp()))
    ok(receipt_ms({"ts": "garbage"}) == 0)
    # R12 heartbeat / silence
    a = D(id="s1", s="running", job="SIL", n="working: 🤫 Silent. z")
    ok(a == [("set", ["s1", "running", f"working: 🤫 Silent. z [{SILENT}]"], "R12 job silent")], a)
    ok(D(id="s1", s="running", job="SIL", n=f"z [{SILENT}]") == [], "flag once")
    ok(D(id="s2", s="running", job="SIL", beat=ms(now - 60)) == [], "a recent fm beat keeps a working pane from being silent")
    ok(D(id="s3", s="running", job="NOACT") == [], "no activity data -> not silent")
    ok(D(id="s4", s="running", job=["SIL", "nightly-build.service"]) == [], "a running unit is never silent")
    a = D(id="s5", s="running", job="W", n=f"working: 🔧 Work. z [{SILENT}]")
    ok(a == [("set", ["s5", "running", "working: 🔧 Work. z"], "R12 activity resumed")], a)
    a = D(id="s6", s="partial", job="W", n=f"z [{SILENT}]"); ok(a[-1][1] == ["s6", "running", "working: 🔧 Work. z"], a)
    ok(D(id="s7", s="running", job="IDL", beat=ms(now - 120)) == [], "R8: a recent beat counts as activity")
    ok(D(id="r5o", s="partial", job="GONE", n=f"x [{ENDED_OLD}]") == [], "the old ended mark is not rewritten")
    a = D(id="r5p", s="running", job="GONE", n=f"working: X. y [{SILENT}]"); ok(a[0][1] == ["r5p", "partial", f"y [{ENDED}]"], a)
    its3 = [P(id="b1", job="IDL", beat=ms(now - 60)), P(id="b2", job="IDL", beat=ms(now - 3 * 3600))]
    ok({i["id"] for i in idle_scan(its3, ctx)[0]} == {"b2"}, "R10: a recent beat is activity")
    print(f"all tests passed ({n})")


if __name__ == "__main__":
    if "--test" in sys.argv:
        test()
    else:
        main("--dry-run" in sys.argv)
