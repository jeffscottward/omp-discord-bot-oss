    ok(D(id="w1", s="waiting", src="https://discord.com/channels/1/2/3") == [], "a waiting (owner action) card stays waiting while a job works")
    a = D(id="r8u", s="running", job="kb-daily-retry.timer", n="working: kb-daily-retry.timer. keep this"); ok(a[0][1][2] == f"keep this [{STOPPED}]", a)
