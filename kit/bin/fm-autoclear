    ok(D(id="dc3", s="running")[0][1][1] == "done", "a receipt with --q (menu already posted) closes the card")
    import tempfile
    DECISION_LEDGER = os.path.join(tempfile.mkdtemp(), "l.json")
    posts, calls = [], []
    fake_post = lambda ch, text: (posts.append(text), {"url": "u0", "asks": [{"questions": [{"url": "https://discord.com/channels/1/2/77"}]}]})[1]
    class Rr: returncode = 0; stderr = ""
    fake_run = lambda argv: (calls.append(argv), Rr())[1]
    global firstmate_channel
    firstmate_channel = lambda: "123"
    r1 = apply_decisions({"t": "T"}, "dc1", "n", '["Use R2?"]', post=fake_post, run=fake_run)
    r2 = apply_decisions({"t": "T"}, "dc1", "n", '["Use R2?"]', post=fake_post, run=fake_run)
    ok(r1 == (True, "https://discord.com/channels/1/2/77") and r2 == r1 and len(posts) == 1, (r1, r2, len(posts)))
    ok("```ask" in posts[0] and calls[0] == ["q", "dc1", "https://discord.com/channels/1/2/77"] and calls[1][2] == "waiting", calls)
    calls2 = []
    ok2, u2 = apply_decisions({"t": "x"}, "dc9", "n", json.dumps(["Choose: delete old artifacts?"]),
                              post=lambda ch, text: {"url": "u1", "alreadyAnswered": [{"question": "q", "answer": ["Allow deleting old CI artifacts"], "url": "https://discord.com/channels/1/2/5"}]},
                              run=lambda argv: (calls2.append(argv), subprocess.CompletedProcess(argv, 0, "", ""))[1])
    ok((ok2 and calls2 and calls2[0][:3] == ["set", "dc9", "partial"] and "Allow deleting" in calls2[0][3]), ("already-answered", calls2))
    # R14 boot gate (card fm-boot-gate, 2026-11-02)
    ctx.update(boot_id="BOOT-1", boot_age=7200.0)
    ok(boot_gate({"id": "x"}, ctx) is None and boot_gate({"id": "x", "bootGate": "BOOT-1"}, ctx) == "held", "no gate / same boot")
    ok(D(id="g1", s="partial", bootGate="BOOT-1", job="GONE") == [], "a gated card (same boot) is left alone (no R5 flag)")
    a = D(id="g2", s="partial", bootGate="BOOT-0"); ok(a == [("field", ["g2", "bootGate", "-"], "R14 boot gate passed (rebooted)")], f"new boot clears the gate: {a}")
    a = D(id="g2n", s="partial", bootGate="BOOT-0", n=f"x [{ENDED}]", job="GONE"); ok(a and a[0][1][1] == "bootGate", "passed gate is cleared first; the card flows from the next pass")
    recs["g3"] = R("g3", "done")
    a = D(id="g3", s="partial", bootGate="BOOT-1"); ok(a and a[0][1][1] == "done" and a[0][2] == "R11 receipt done", f"a receipt applies while gated: {a}")
    recs["g3f"] = R("g3f", "failed")
    a = D(id="g3f", s="partial", bootGate="BOOT-1"); ok(a and a[0][1][1] == "partial" and "[needs check]" in a[0][1][2], f"a failed receipt applies while gated: {a}")
    gits = [P(id="gi1", bootGate="BOOT-1"), P(id="gi2", bootGate="BOOT-0"), P(id="gi3")]
    idl, skp = idle_scan(gits, ctx)
    ok({i["id"] for i in idl} == {"gi2", "gi3"}, f"same boot -> not idle; new boot -> idle again: {sorted(i['id'] for i in idl)}")
    ok({"id": "gi1", "reason": "waits for next boot (boot gate)"} in skp, skp)
    ctx["boot_age"] = 60.0  # rebooted 1 min ago: the boot check may still write its receipt
    ok(D(id="g4", s="partial", bootGate="BOOT-0") == [] and "gi2" not in {i["id"] for i in idle_scan(gits, ctx)[0]}, "a young new boot keeps the gate")
    ctx.update(boot_id="", boot_age=7200.0)  # boot id unreadable: never clear a gate by mistake
    ok(D(id="g5", s="partial", bootGate="BOOT-0") == [] and boot_gate({"bootGate": "BOOT-0"}, ctx) == "held", "unknown boot keeps the gate")
    # R15 blocker done (card mq-blocked-reason-full)
    ctx["items"] = [{"id": "bd-a", "s": "done"}, {"id": "bd-b", "s": "done"}, {"id": "bd-o", "s": "running"}]
    a = D(id="bd1", s="partial", blockedBy=["bd-a", "bd-b"], n="🧾 Receipt blocked (11-03 10:00): waits. [blocked by bd-a, bd-b]")
    ok(a == [("set", ["bd1", "partial", "🧾 Receipt blocked (11-03 10:00): waits. [blocker done; needs check]"], "R15 blocker done")], f"R15 all blockers done: {a}")
    a = D(id="bd2", s="partial", blockedBy="bd-a,bd-o", n="x [blocked by bd-a, bd-o]")
    ok(not any(x[2] == "R15 blocker done" for x in a), f"R15 one blocker open: {a}")
    a = D(id="bd3", s="partial", blockedBy=["bd-a", "ghost"], n="x [blocked by bd-a, ghost]")
    ok(not any(x[2] == "R15 blocker done" for x in a), f"R15 unknown blocker is not done: {a}")
    a = D(id="bd4", s="partial", blockedBy=["bd-a"], n="x [blocker done; needs check]")
    ok(not any(x[2] == "R15 blocker done" for x in a), f"R15 idempotent: {a}")
    a = D(id="bd5", s="partial", blockedBy=["bd-a"], n="y" * 700 + " [blocked by bd-a]")
    ok(a[0][1][2].endswith(" [blocker done; needs check]") and len(a[0][1][2]) <= 600, f"R15 long note keeps the flag: {len(a[0][1][2])}")
    ctx.pop("items")
    ctx.pop("boot_id"); ctx.pop("boot_age")
    print(f"all tests passed ({n})")


if __name__ == "__main__":
    if "--test" in sys.argv:
        test()
    else:
        main("--dry-run" in sys.argv)
        # Owner 2026-10-30 (card needs-you-ntfy): one ntfy push per card that newly needs the owner.
        if "--dry-run" not in sys.argv:
            try:
                subprocess.run([os.path.expanduser("~/.local/bin/fm-needs-ntfy")], timeout=120)
            except Exception as e:
                print(f"fm-needs-ntfy: {e}")
