# FIRSTMATE kit settings: copy to ~/.config/omp-discord/kit.env (kit/install.sh does this when the file is missing).
# Format: KEY=VALUE, one per line, comments on their own lines only. The file is valid shell (bash can source it).
# Double quotes expand $HOME and earlier keys; single quotes keep the text as it is (use them for regex values).
# A variable that is already set in the environment wins over this file. Another file: set OMP_KIT_ENV=/path.
# No secrets here: the bot token stays in ~/.config/omp-discord/bot.env.

# ---------- paths ----------
# Report pages folder. omp-reports-web serves it; the dashboard is its "firstmate" subfolder.
REPORTS_WEB_DIR="$HOME/.local/share/omp-discord/reports-web"
# FIRSTMATE dashboard folder: app files + tracker data (items.json, running.json, receipts/ ...).
# Keep it at $REPORTS_WEB_DIR/firstmate, so /reports/firstmate/ links work (install.sh links it there if not).
FM_DIR="$REPORTS_WEB_DIR/firstmate"
# The omp-discord-bot checkout. Default: the repo that holds the kit scripts (found from the script location).
# OMP_BOT_REPO="$HOME/Github/omp-discord-bot"

# ---------- report server (omp-reports-web.service, kit/web/serve.py) ----------
# Port and address of the loopback report server. Publish it with `tailscale serve`; do not bind a public address.
REPORTS_PORT=8790
REPORTS_BIND=127.0.0.1
# Public dashboard URL (links in Discord, live browser tests). With tailscale serve, for example:
# FM_DASHBOARD_URL="https://<host>.<your-tailnet>/reports/firstmate/"
FM_DASHBOARD_URL="http://127.0.0.1:8790/firstmate/"

# ---------- Discord bot ----------
# The bot's loopback /post endpoint (body {channel, text}).
OMP_BOT_POST_URL="http://127.0.0.1:47821/post"
# Alerts channel for fm-notify (channel id, or a name the bot knows from config.json).
FM_ALERTS_CHANNEL="omp-alerts"
# FIRSTMATE channel (id or name). The reminders digest uses it when REMINDERS_CHANNEL is empty and this is an id.
FM_CHANNEL="firstmate"
# Bot secrets file (fm-autoclear reads DISCORD_BOT_TOKEN from it to see answers to open questions).
OMP_BOT_ENV="$HOME/.config/omp-discord/bot.env"
# Alert sender command line. It gets --kind, --summary and --action. Empty: kit/bin/fm-notify (posts via the bot).
OMP_NOTIFY=""
# auth-pane: preferred transport for sign-in notices (passed as OMP_NOTIFY_TRANSPORT, e.g. ntfy). Empty: the default.
AUTH_PANE_NOTIFY_TRANSPORT=""

# ---------- Herdr / tracker rules ----------
# Herdr CLI. Empty: ~/.local/bin/herdr when it exists, else herdr on PATH.
HERDR_BIN=""
# firstmate-sweep opens its tab in the workspace of the tab with this label.
FM_SWEEP_HOME_TAB="FIRSTMATE"
# fm-tabwatch never changes cards in these areas or with these title words. fm-autoclear skips only these areas, and applies worker receipts on every card (owner 2026-10-22).
FM_SKIP_AREAS="finance"
# Title words for fm-tabwatch only. fm-autoclear decides 'finance' by the card area only (owner 2026-10-22).
FM_SKIP_WORDS='order|trade|finance'

# ---------- running view (build-running.py) ----------
# Label of this machine in job tags ("<label>:<unit>") and on the dashboard.
FM_HOST_LABEL="local"
# Service groups on the Running tab, in order: 'Group=unit-name regex;Group=regex'. Units that match no regex are not shown.
FM_SERVICE_GROUPS='Discord + OMP=^(omp-|channel-cleanup);Reminders=^reminders-;Maintenance=^(firstmate-|fm-)'
# Extra links from a unit row to a report: 'unit.service=/reports/path;unit2.service=/reports/other'.
FM_SERVICE_LINKS=""
# Units to show even when they are not installed: 'unit.service|Group|description;...'.
FM_EXPECTED_UNITS=""
# Optional second machine, read-only over ssh (system units). Empty FM_PEER_HOST = off.
FM_PEER_HOST=""
# ssh target for the peer (a Host alias in ~/.ssh/config with key login; strict host keys). Empty: FM_PEER_HOST.
FM_PEER_SSH=""
# Group name of the peer rows on the dashboard. Empty: FM_PEER_HOST.
FM_PEER_GROUP=""
# Peer units to list: systemctl globs (space-separated) and an optional regex filter.
FM_PEER_UNIT_GLOBS=""
FM_PEER_UNIT_PATTERN=""
# Dashboard link for every peer row (optional).
FM_PEER_LINK=""

# ---------- tests (firstmate-tests, kit/test.sh) ----------
# 1 = browser tests read the live dashboard (FM_DASHBOARD_URL); 0 = a temp copy with kit/dashboard/fixtures.
FM_TESTS_LIVE=0
# require() path of puppeteer-core (npm i -g puppeteer-core, or an absolute path to a node_modules/puppeteer-core).
PUPPETEER_CORE="puppeteer-core"
# Chrome/Chromium binary. Empty: the first one found (chromium, google-chrome-stable, ...).
CHROME_BIN=""

# ---------- reminders inbox (kit/reminders-inbox) ----------
# Data folder (latest.txt, todo.md, queues).
REMINDERS_DIR="$HOME/.local/share/reminders-inbox"
# Address and port. For the iPhone Shortcut, set your tailnet IP (`tailscale ip -4`); never a public address.
REMINDERS_BIND=127.0.0.1
REMINDERS_PORT=47830
# Channel id for the 8 AM digest. Empty: FM_CHANNEL when it is an id, else the default of scripts/notify-owner.ts.
REMINDERS_CHANNEL=""

# ---------- install ----------
# Units that `kit/install.sh --enable` must not enable (space-separated), for example "firstmate-sweep.timer".
KIT_SKIP_UNITS=""
